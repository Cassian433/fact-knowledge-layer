# LLM backend: claude_cli (uses the local Claude Code login) or anthropic (official SDK; needs ANTHROPIC_API_KEY or `ant auth login`)
FACTLAYER_LLM_BACKEND=claude_cli
# FACTLAYER_MODEL_FAST=sonnet        # bulk extraction (anthropic backend: claude-sonnet-5)
# FACTLAYER_MODEL_SMART=opus         # cross-document judgement (anthropic backend: claude-opus-5)
FACTLAYER_LLM_CONCURRENCY=12
# FACTLAYER_CHUNK_CHARS=18000
# FACTLAYER_SIM_THRESHOLD=0.86
# FACTLAYER_MAX_NEIGHBOURS=5
